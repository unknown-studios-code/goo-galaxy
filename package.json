{
  "author": "Unknown Studios",
  "description": "A real-time PvP mobile strategy game combining Ataxx/Hexxagon-style hexagonal territorial domination with asymmetrical deck-building and troop deployment, set in a sci-fi universe of sentient alien slimes.",
  "homepage": "https://github.com/unknown-studios-code/goo-galaxy#readme",
  "main": ".vscode/launch.json",
  "name": "goo-galaxy",
  "version": "0.0.1",
  "bugs": {
    "url": "https://github.com/unknown-studios-code/goo-galaxy/issues"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "keywords": [
    "mobile",
    "strategy",
    "pvp",
    "ataxx",
    "unity",
    "multiplayer"
  ],
  "lint-staged": {
    "*.{json,md,mdc,yml,yaml}": "prettier --write --ignore-path .formatterignore",
    "Assets/{Scripts,Editor}/**/*.cs": [
      "dotnet csharpier format --ignore-path .formatterignore",
      "dotnet format goo-galaxy.slnx --severity info --verbosity quiet --include"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unknown-studios-code/goo-galaxy.git"
  },
  "scripts": {
    "check": "npm run check:csharpier && npm run check:dotnet && npm run check:prettier",
    "check:csharpier": "dotnet csharpier check Assets/Scripts Assets/Editor --ignore-path .formatterignore",
    "check:dotnet": "dotnet format goo-galaxy.slnx --include \"Assets/Scripts/**/*.cs\" \"Assets/Editor/**/*.cs\" --severity info --verify-no-changes --verbosity quiet",
    "check:prettier": "prettier --check \"**/*.{json,md,mdc,yml,yaml}\" --ignore-path .formatterignore",
    "format": "npm run format:csharpier && npm run format:dotnet && npm run format:prettier",
    "format:csharpier": "dotnet csharpier format Assets/Scripts Assets/Editor --ignore-path .formatterignore",
    "format:dotnet": "dotnet format goo-galaxy.slnx --include \"Assets/Scripts/**/*.cs\" \"Assets/Editor/**/*.cs\" --severity info --verbosity quiet",
    "format:prettier": "prettier --write \"**/*.{json,md,mdc,yml,yaml}\" --ignore-path .formatterignore",
    "prepare": "husky && dotnet tool restore",
    "unity:console": "pwsh -NoProfile -File scripts/unity-console.ps1",
    "unity:console:mark": "pwsh -NoProfile -File scripts/unity-console.ps1 -Mark",
    "unity:recompile": "pwsh -NoProfile -File scripts/unity-recompile.ps1",
    "unity:test:editmode": "pwsh -NoProfile -File scripts/unity-test-editmode.ps1",
    "unity:test:playmode": "pwsh -NoProfile -File scripts/unity-test-playmode.ps1"
  }
}
