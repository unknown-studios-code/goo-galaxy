{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git shortlog:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git worktree list)",
      "Bash(npm run format)",
      "Bash(npm run format:*)",
      "Bash(npm run check)",
      "Bash(npm run check:*)",
      "Bash(npm ls:*)",
      "Bash(npm outdated:*)",
      "Bash(dotnet --info)",
      "Bash(dotnet --version)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet tool list:*)",
      "Bash(dotnet csharpier check:*)",
      "Bash(gh pr status)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh label list:*)",
      "Bash(gh repo view:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git blame:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git shortlog:*)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch -a)",
      "PowerShell(git remote -v)",
      "PowerShell(git stash list)",
      "PowerShell(git worktree list)",
      "PowerShell(npm run format)",
      "PowerShell(npm run format:*)",
      "PowerShell(npm run check)",
      "PowerShell(npm run check:*)",
      "PowerShell(npm ls:*)",
      "PowerShell(npm outdated:*)",
      "PowerShell(dotnet --info)",
      "PowerShell(dotnet --version)",
      "PowerShell(dotnet tool restore)",
      "PowerShell(dotnet tool list:*)",
      "PowerShell(dotnet csharpier check:*)",
      "PowerShell(gh pr status)",
      "PowerShell(gh pr list:*)",
      "PowerShell(gh pr view:*)",
      "PowerShell(gh pr diff:*)",
      "PowerShell(gh pr checks:*)",
      "PowerShell(gh issue list:*)",
      "PowerShell(gh issue view:*)",
      "PowerShell(gh run list:*)",
      "PowerShell(gh run view:*)",
      "PowerShell(gh label list:*)",
      "PowerShell(gh repo view:*)"
    ],
    "deny": [
      "Write(Assets/**/*.meta)",
      "Write(Assets/**/*.asset)",
      "Edit(Assets/**/*.meta)",
      "Edit(Assets/**/*.asset)",
      "MultiEdit(Assets/**/*.meta)",
      "MultiEdit(Assets/**/*.asset)"
    ]
  }
}
