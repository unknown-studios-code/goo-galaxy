:root {
  --color-player-one: rgb(0, 245, 255);
  --color-player-two: rgb(255, 45, 170);
  --color-surface: rgba(11, 15, 26, 0.85);
  --color-track: rgb(43, 45, 66);
  --color-text: rgb(236, 240, 247);
  --spacing-s: 8px;
  --spacing-m: 16px;
}

.hud {
  flex-grow: 1;
  justify-content: space-between;
  padding: var(--spacing-m);
}

.hud__energy-panel {
  flex-direction: column;
  background-color: var(--color-surface);
  border-radius: 12px;
  padding: var(--spacing-m);
}

.energy-bar {
  flex-direction: row;
  align-items: center;
  height: 44px;
}

/* gap is unsupported in USS — space the rows with a margin on the child instead. */
.energy-bar {
  margin-bottom: var(--spacing-s);
}

.energy-bar__caption {
  width: 48px;
  -unity-text-align: middle-left;
  -unity-font-style: bold;
  font-size: 26px;
}

.energy-bar__caption--player-one {
  color: var(--color-player-one);
}

.energy-bar__caption--player-two {
  color: var(--color-player-two);
}

.energy-bar__track {
  flex-grow: 1;
  height: 22px;
  background-color: var(--color-track);
  border-radius: 8px;
  overflow: hidden;
}

.energy-bar__fill {
  height: 100%;
  width: 0%;
  border-radius: 8px;
}

.energy-bar__fill--player-one {
  background-color: var(--color-player-one);
}

.energy-bar__fill--player-two {
  background-color: var(--color-player-two);
}

.energy-bar__value {
  width: 92px;
  color: var(--color-text);
  -unity-text-align: middle-right;
  font-size: 24px;
}

.energy-bar__troops {
  width: 60px;
  color: var(--color-text);
  -unity-text-align: middle-right;
  -unity-font-style: bold;
  font-size: 24px;
}

.hud__footer {
  align-items: center;
  flex-direction: column;
}

.hud__result-label {
  color: var(--color-text);
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  font-size: 44px;
  margin-bottom: var(--spacing-m);
  display: none;
}

.hud__result-label--visible {
  display: flex;
}

.hud__reset-button {
  width: 240px;
  height: 76px;
  font-size: 26px;
  color: var(--color-text);
  background-color: var(--color-track);
  border-radius: 12px;
  border-width: 0;
}

.hud__reset-button:hover {
  background-color: rgb(60, 63, 90);
}

.hud__reset-button:active {
  background-color: rgb(28, 30, 46);
}

/* --- Hand ------------------------------------------------------------- */

.hand {
  flex-direction: row;
  justify-content: center;
  margin-bottom: var(--spacing-m);
}

.hand__card {
  width: 120px;
  height: 160px;
  border-radius: 12px;
  border-width: 4px;
  border-color: rgba(0, 0, 0, 0);
  justify-content: flex-end;
  align-items: center;
  padding-bottom: 12px;
  margin-right: 10px;
}

.hand__card--selected {
  border-color: var(--color-text);
  scale: 1.08 1.08;
}

/* Dimmed while the active player cannot pay for it. */
.hand__card--unaffordable {
  opacity: 0.35;
}

.hand__card-name {
  color: rgb(11, 15, 26);
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  font-size: 18px;
  white-space: normal;
  width: 100%;
}

.hand__card-cost {
  position: absolute;
  top: 8px;
  left: 12px;
  color: rgb(11, 15, 26);
  -unity-font-style: bold;
  font-size: 30px;
}

/* --- Controls --------------------------------------------------------- */

.hud__controls {
  flex-direction: row;
  justify-content: center;
}

.hud__controls > * {
  margin-right: var(--spacing-s);
}

.hud__player-button {
  width: 240px;
  height: 76px;
  font-size: 26px;
  color: var(--color-text);
  background-color: var(--color-track);
  border-radius: 12px;
  border-width: 4px;
  border-color: var(--color-player-one);
}

.hud__player-button--player-two {
  border-color: var(--color-player-two);
}
